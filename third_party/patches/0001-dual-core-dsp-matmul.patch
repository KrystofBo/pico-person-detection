+/*
+ * Dual-core work dispatch for CMSIS-NN kernels on the RP2350.
+ *
+ * Not part of upstream CMSIS-NN. Added by
+ * third_party/patches/0001-dual-core-dsp-matmul.patch in the
+ * pico-person-detection repository.
+ *
+ * Upstream's TF_LITE_PICO_MULTICORE support in arm_nn_mat_mult_nt_t_s8.c only
+ * compiles into the plain-C fallback path, so on a core with the DSP extension
+ * (RP2350 / Cortex-M33) it is unreachable and core 1 idles through the whole
+ * inference. These helpers let the DSP kernels split one operator across both
+ * cores.
+ *
+ * The implementation lives in arm_nn_mat_mult_nt_t_s8.c: it owns mutable state
+ * (the parked core-1 thread), so it must be a single definition rather than a
+ * static inline that every translation unit would duplicate.
+ *
+ * Once any kernel calls pico_nn_run_pair(), core 1 belongs to CMSIS-NN for the
+ * lifetime of the program and must not be used for anything else.
+ */
+
+#ifndef PICO_NN_MULTICORE_H_
+#define PICO_NN_MULTICORE_H_
+
+/*
+ * Deliberately not upstream's TF_LITE_PICO_MULTICORE, which selects the plain-C
+ * dual-core path and is #defined per translation unit in
+ * arm_nn_mat_mult_nt_t_s8.c. This switch selects the DSP dual-core path and has
+ * to hold across every kernel that uses it. Define it as 0 to build single-core.
+ */
+#ifndef PICO_NN_DUAL_CORE
+#define PICO_NN_DUAL_CORE 1
+#endif
+
+typedef void (*pico_nn_task_fn)(void *arg);
+
+/*
+ * Runs fn(core0_arg) on this core and fn(core1_arg) on core 1, and returns once
+ * both have finished. The two calls must write to disjoint memory; byte stores
+ * from the two cores are safe even within one word, as the RP2350's SRAM has
+ * byte write enables and no read-modify-write.
+ *
+ * Launches core 1 on first use and parks it on the inter-core FIFO afterwards,
+ * because a multicore_reset_core1() + multicore_launch_core1() per call costs
+ * more than the smaller layers gain.
+ *
+ * Must only be called from core 0.
+ */
+void pico_nn_run_pair(pico_nn_task_fn fn, void *core0_arg, void *core1_arg);
+
+#endif /* PICO_NN_MULTICORE_H_ */
